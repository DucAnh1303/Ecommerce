<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ══════════════════════════════════════════════════════════════
         📌 Properties
    ══════════════════════════════════════════════════════════════ -->

    <!-- Đọc từ application.yaml: logging.file.path -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="/Users/aidenphung/Documents/ShopDA/Log_BE/Auth_Logs" />

    <!-- Tên service (đọc từ spring.application.name) -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="AUTH-SERVICE" />

    <!-- Format dùng cho FILE (không màu) -->
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%logger{36}] - %msg%n" />

    <!-- Format dùng cho CONSOLE (có màu ANSI) -->
    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan([%thread]) %yellow(%logger{36}) - %msg%n" />


    <!-- ══════════════════════════════════════════════════════════════
         🖥️  CONSOLE Appender  (chỉ dùng ở profile dev)
    ══════════════════════════════════════════════════════════════ -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- ══════════════════════════════════════════════════════════════
         📄 FILE Appender  – INFO và cao hơn
         Rolling: mỗi ngày 1 file, tối đa 30 ngày / 500 MB
    ══════════════════════════════════════════════════════════════ -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Pattern tên file khi roll -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>2</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- ══════════════════════════════════════════════════════════════
         🔴 ERROR FILE Appender  – chỉ ghi level ERROR
    ══════════════════════════════════════════════════════════════ -->

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>

        <!-- Chỉ ghi ERROR -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>2</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- ══════════════════════════════════════════════════════════════
         ⚡ ASYNC Wrappers  – tránh block thread khi ghi disk
    ══════════════════════════════════════════════════════════════ -->

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>   <!-- không bỏ bất kỳ log nào -->
        <includeCallerData>false</includeCallerData>   <!-- tắt để giảm overhead -->
        <appender-ref ref="FILE" />
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE" />
    </appender>


    <!-- ══════════════════════════════════════════════════════════════
         🔕 Giảm noise từ các thư viện bên thứ ba
    ══════════════════════════════════════════════════════════════ -->

    <logger name="org.hibernate.SQL"                     level="WARN" />
    <logger name="org.hibernate.orm"                     level="WARN" />
    <logger name="com.zaxxer.hikari"                     level="WARN" />
    <logger name="org.springframework.security"          level="WARN" />
    <logger name="org.springframework.web"               level="INFO" />
    <logger name="io.lettuce"                            level="WARN" />

    <!-- Logger riêng cho code của ứng dụng (luôn ở INFO) -->
    <logger name="web.com.auth" level="INFO" />


    <!-- ══════════════════════════════════════════════════════════════
         🌱 Profile: dev / default / local  →  console + file
    ══════════════════════════════════════════════════════════════ -->

    <springProfile name="dev,default,local">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ASYNC_FILE" />
            <appender-ref ref="ASYNC_ERROR_FILE" />
        </root>
    </springProfile>


    <!-- ══════════════════════════════════════════════════════════════
         🚀 Profile: prod  →  file only
    ══════════════════════════════════════════════════════════════ -->

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE" />
            <appender-ref ref="ASYNC_ERROR_FILE" />
        </root>
    </springProfile>

</configuration>